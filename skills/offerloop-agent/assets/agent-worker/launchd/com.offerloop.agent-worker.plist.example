<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.offerloop.agent-worker</string>
    <key>ProgramArguments</key>
    <array>
      <string>__NODE_BIN__</string>
      <string>__WORKER_DIR__/src/worker.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__WORKER_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>CODEX_BIN</key>
      <string>__CODEX_BIN__</string>
      <key>OFFERLOOP_SOURCE_ROOT</key>
      <string>__OFFERLOOP_SOURCE_ROOT__</string>
      <key>OFFERLOOP_RUNTIME_WORKSPACE</key>
      <string>__OFFERLOOP_RUNTIME_WORKSPACE__</string>
      <key>OFFERLOOP_WORKBENCH_URL</key>
      <string>__OFFERLOOP_WORKBENCH_URL__</string>
      <key>OFFERLOOP_WORKBENCH_APP_ID</key>
      <string>__OFFERLOOP_WORKBENCH_APP_ID__</string>
      <key>OFFERLOOP_MIAODA_USER_ID</key>
      <string>__OFFERLOOP_MIAODA_USER_ID__</string>
      <key>PATH</key>
      <string>__PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/com.offerloop.agent-worker.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.offerloop.agent-worker.log</string>
  </dict>
</plist>

OFFERLOOP_SOURCE_ROOT=/absolute/path/to/OfferLoop
OFFERLOOP_RUNTIME_WORKSPACE=/absolute/path/to/agent-runtime-cache
OFFERLOOP_WORKBENCH_URL=https://your-workbench.example/app/app_xxx
OFFERLOOP_WORKBENCH_APP_ID=app_xxx
OFFERLOOP_MIAODA_USER_ID=your_numeric_miaoda_user_id
# 可选；默认由妙搭用户 ID 和主机名生成，避免共享工作台中的 Worker 冲突
# OFFERLOOP_WORKER_ID=offerloop-123456789-my-mac
OFFERLOOP_WORKER_NAME=OfferLoop Mac
OFFERLOOP_POLL_INTERVAL_MS=1000
# macOS 默认从钥匙串读取。其他系统可使用：
# OFFERLOOP_WORKBENCH_API_KEY=replace-with-the-one-time-api-key
CODEX_BIN=codex

{
  "paths": {
    "/openapi/agent-worker/poll": {
      "post": {
        "operationId": "poll",
        "summary": "本机 OfferLoop Agent 上报在线状态并领取任务",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["workerId", "displayName", "codexAvailable"],
                "properties": {
                  "workerId": {
                    "type": "string",
                    "description": "本机 Worker 的稳定标识",
                    "example": "offerloop-mac"
                  },
                  "displayName": {
                    "type": "string",
                    "description": "本机 Worker 的展示名称",
                    "example": "用户的 Mac"
                  },
                  "codexAvailable": {
                    "type": "boolean",
                    "description": "当前 Codex CLI 是否可用",
                    "example": true
                  },
                  "version": {
                    "type": "string",
                    "description": "本机 Worker 版本",
                    "example": "0.2.0"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "在线状态已登记，并返回一个待执行任务（如有）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["connected"],
                  "properties": {
                    "connected": {
                      "type": "boolean",
                      "description": "Worker 是否可领取任务",
                      "example": true
                    },
                    "task": {
                      "type": "object",
                      "description": "本次领取的 Agent 任务",
                      "example": {
                        "runId": "6a49d8e9-2e7a-4c7a-a0d8-92d0434f87f1",
                        "message": "帮我准备明天的产品经理面试",
                        "route": "interview-prep",
                        "confirmed": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/agent-worker/run-update": {
      "post": {
        "operationId": "updateRun",
        "summary": "回传本机 OfferLoop Agent 的任务状态与结果",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["runId", "workerId", "status"],
                "properties": {
                  "runId": {
                    "type": "string",
                    "description": "Agent 任务 ID",
                    "example": "6a49d8e9-2e7a-4c7a-a0d8-92d0434f87f1"
                  },
                  "workerId": {
                    "type": "string",
                    "description": "领取任务的 Worker 标识",
                    "example": "offerloop-mac"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["running", "cancelled", "completed", "failed"],
                    "description": "任务当前状态",
                    "example": "completed"
                  },
                  "progress": {
                    "type": "string",
                    "description": "可展示的执行进度",
                    "example": "已完成"
                  },
                  "result": {
                    "type": "string",
                    "description": "任务完成后的 Agent 回复",
                    "example": "已经使用 interview-prep Skill 完成面试准备。"
                  },
                  "error": {
                    "type": "string",
                    "description": "任务失败原因",
                    "example": "Codex CLI 暂时不可用"
                  },
                  "sessionId": {
                    "type": "string",
                    "description": "用于延续对话的 Codex 会话 ID",
                    "example": "019f9e97-35d3-7a10-87c7-6bca15798f7a"
                  },
                  "recoveredFromSessionId": {
                    "type": "string",
                    "description": "Codex 检测到已归档失配时被替换的旧会话 ID",
                    "example": "019f9e97-35d3-7a10-87c7-6bca15798f79"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务状态已更新",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["accepted"],
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "description": "本次状态更新是否已接受",
                      "example": true
                    },
                    "cancelRequested": {
                      "type": "boolean",
                      "description": "用户是否已从工作台请求停止当前任务",
                      "example": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

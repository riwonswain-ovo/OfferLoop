{
  "paths": {
    "/openapi/job-progress-sync": {
      "post": {
        "operationId": "sync",
        "summary": "按企业投递进度双向对账求职进展",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sourceRecordId"],
                "properties": {
                  "sourceRecordId": {
                    "type": "string",
                    "description": "企业清单主表记录 ID",
                    "example": "recvoGKVsf3kts"
                  },
                  "transitionedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "记录进入已投递状态的时间",
                    "example": "2026-07-17T19:00:00+08:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "同步成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "action", "recordId"],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "action": {
                      "type": "string",
                      "enum": ["created", "updated", "deleted", "review_required", "unchanged"],
                      "description": "本次双向幂等对账采取的动作",
                      "example": "created"
                    },
                    "recordId": {
                      "type": "string",
                      "description": "求职进展记录 ID",
                      "example": "rec_progress_example"
                    },
                    "matchedCount": {
                      "type": "integer",
                      "description": "离开已投递状态时匹配到的求职进展数"
                    },
                    "deletedCount": {
                      "type": "integer",
                      "description": "安全删除的未维护自动默认行数"
                    },
                    "protectedCount": {
                      "type": "integer",
                      "description": "因已推进或人工维护而保留、需要复核的记录数"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "来源记录缺失或来源字段不完整"
          },
          "503": {
            "description": "飞书接口暂时不可用"
          }
        }
      }
    },
    "/openapi/job-progress-sync/health": {
      "get": {
        "operationId": "health",
        "summary": "检查求职进展同步服务状态",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "service"],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "service": {
                      "type": "string",
                      "enum": ["job-progress-sync"],
                      "example": "job-progress-sync"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/job-progress-sync/reminder-reconcile": {
      "post": {
        "operationId": "reconcileReminder",
        "summary": "根据笔面试安排记录的完成状态实时推进求职进展",
        "parameters": [
          {
            "name": "x-offerloop-workflow-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "仅存放在妙搭环境变量和 Base workflow 中的对账密钥"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "优先传记录定位字段；若飞书运行时未填充动态变量，服务端对唯一的笔面试安排主表执行幂等全量对账。",
                "properties": {
                  "recordId": {
                    "type": "string",
                    "description": "发生完成状态变更的笔面试安排记录 ID",
                    "example": "recReminderExample"
                  },
                  "recordLink": {
                    "type": "string",
                    "description": "发生完成状态变更的笔面试安排记录链接",
                    "example": "https://example.feishu.cn/base/baseToken?table=tblExample&record=recReminderExample"
                  },
                  "sourceEmailId": {
                    "type": "string",
                    "description": "飞书工作流未提供内置记录标识时，用来源邮件 ID 精确定位记录"
                  },
                  "recordTitle": {
                    "type": "string",
                    "description": "来源邮件 ID 缺失时，用唯一安排名称定位记录"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "笔面试安排记录与关联求职进展已完成即时对账"
          },
          "400": {
            "description": "笔面试安排记录 ID、记录链接或完成状态无效"
          },
          "401": {
            "description": "缺少或提供了错误的 workflow 对账密钥"
          },
          "503": {
            "description": "飞书接口暂时不可用"
          }
        }
      }
    },
    "/openapi/job-progress-sync/card-action": {
      "post": {
        "operationId": "cardAction",
        "summary": "处理 OfferLoop 每日确认卡片回调或飞书 challenge 验证",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "飞书 card.action.trigger schema 2.0 事件或 challenge 请求"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "回调已确认；完成操作在后台幂等同步 Base，尚未完成操作不产生写入"
          },
          "400": {
            "description": "回调身份、群聊或按钮值无效"
          }
        }
      }
    }
  }
}

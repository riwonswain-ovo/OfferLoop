{
  "schema_version": 1,
  "template_id": "offerloop-progress-sync",
  "display_name": "OfferLoop 求职进展同步服务",
  "stack": "nestjs-react-fullstack",
  "requires_fresh_miaoda_binding": true,
  "required_environment": [
    "FEISHU_APP_ID",
    "FEISHU_APP_SECRET",
    "SOURCE_BASE_TOKEN",
    "SOURCE_TABLE_ID",
    "PROGRESS_BASE_TOKEN",
    "PROGRESS_TABLE_ID",
    "REMINDER_BASE_TOKEN",
    "REMINDER_TABLE_ID",
    "REMINDER_RECONCILE_SECRET",
    "RUNTIME_STATE_TABLE_ID",
    "DAILY_CHECKIN_STATUS"
  ],
  "conditional_environment": [
    {
      "when": { "DAILY_CHECKIN_STATUS": "enabled" },
      "required": [
        "DAILY_CHECKIN_CHAT_ID",
        "DAILY_CHECKIN_OWNER_OPEN_ID",
        "DAILY_CHECKIN_CALENDAR_ID",
        "FEISHU_CALLBACK_VERIFICATION_TOKEN"
      ]
    }
  ],
  "protected_destination_paths": [
    ".git",
    ".spark",
    ".spark_project",
    ".env",
    ".env.local"
  ]
}
